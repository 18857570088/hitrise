# Android build/local machine files
hitrise-android/.gradle/
hitrise-android/**/build/
hitrise-android/local.properties
*.apk
*.aab

# Python/server generated files
**/__pycache__/
*.py[cod]
.pytest_cache/
.venv/
hitrise-server/.venv/
