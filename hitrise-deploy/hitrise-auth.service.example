[Unit]
Description=HitRise Activation API
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hitrise-auth
EnvironmentFile=/etc/hitrise-auth.env
ExecStart=/opt/hitrise-auth/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8014
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
